{
  "name": "streamflicker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run generate:catalog",
    "generate:catalog": "node scripts/generate-catalog.mjs",
    "prebuild": "npm run generate:catalog",
    "build": "tsc -b && vite build && node scripts/generate-seo.mjs",
    "test:catalog-generation": "node scripts/test-catalog-generation.mjs",
    "test:seo": "node scripts/test-seo.mjs",
    "lint": "oxlint",
    "test": "node scripts/generate-catalog.mjs --check && node scripts/run-tests.mjs",
    "perf:benchmark": "node scripts/perf-benchmark.mjs",
    "preview": "vite preview",
    "ios:add": "cap add ios",
    "ios:assets": "npx @capacitor/assets@3.0.5 generate --ios --assetPath assets --iconBackgroundColor \"#09090b\" --iconBackgroundColorDark \"#09090b\" --splashBackgroundColor \"#09090b\" --splashBackgroundColorDark \"#09090b\"",
    "ios:sync": "npm run build && cap sync ios && node scripts/sync-eas-xcodeproj.mjs",
    "ios:open": "cap open ios",
    "ios:run": "cap run ios",
    "eas:config": "npx eas-cli@latest config --platform ios --profile production --json",
    "eas:credentials:ios": "npx eas-cli@latest credentials --platform ios",
    "eas:build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "eas:build:ios:submit": "npx eas-cli@latest build --platform ios --profile production --auto-submit",
    "eas:submit:ios": "npx eas-cli@latest submit --platform ios --profile production",
    "eas-build-post-install": "node scripts/validate-release-env.mjs && npm run ios:sync",
    "video:render": "remotion render remotion/index.ts StreamFlickerAd videos/streamflicker-remotion-30s/renders/streamflicker-remotion-30s.mp4 --codec=h264 --crf=18 --concurrency=2",
    "video:studio": "remotion studio remotion/index.ts"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/share": "^8.0.1",
    "@supabase/supabase-js": "^2.110.9",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@remotion/cli": "4.0.503",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "remotion": "4.0.503",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
