{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/business", "destination": "/about", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ] },
    { "source": "/:path*", "has": [{ "type": "query", "key": "q" }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/:path*", "has": [{ "type": "query", "key": "movie" }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/:path*", "has": [{ "type": "query", "key": "plan" }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/api/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
