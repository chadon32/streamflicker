# Public Supabase project configuration. Enforce Row Level Security in Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional browser-visible TMDB key. Prefer a restricted client key or a server proxy.
VITE_TMDB_API_KEY=

# Optional affiliate identifiers. Only use IDs from programs that have approved StreamFlicker.
VITE_AFFILIATE_AMAZON_TAG=
VITE_AFFILIATE_APPLE_TOKEN=
VITE_AFFILIATE_IMPACT_SUB_ID=
VITE_AFFILIATE_EBAY_CAMPAIGN_ID=
# Optional first-party endpoint for privacy-conscious outbound click reporting.
VITE_AFFILIATE_CLICK_ENDPOINT=

# Optional website-only destinations. Leave blank until the provider is ready.
VITE_NEWSLETTER_URL=
VITE_SUPPORT_URL=
