# Public Supabase project configuration. Enforce Row Level Security in Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Edge Function server setting (configure in Supabase, never as VITE_*).
# Comma-separated exact web/native origins allowed to call delete-account.
SUPABASE_DELETE_ACCOUNT_ALLOWED_ORIGINS=https://streamflicker.com,https://www.streamflicker.com,https://streamflicker.vercel.app,capacitor://localhost,ionic://localhost

# Preferred server-only TMDB credential for the Vercel Function. Never prefix it with VITE_.
TMDB_API_READ_ACCESS_TOKEN=
# A server-only TMDB v3 API key can be used instead of the read-access token.
TMDB_API_KEY=

# Optional browser-visible local-development fallback. Use only a restricted client key.
VITE_TMDB_API_KEY=
# ISO 3166-1 country code used for regional watch-provider results.
VITE_TMDB_WATCH_REGION=US
# HTTPS origin that hosts /api/tmdb-search for Capacitor/native builds.
# Web builds use their own origin by default. Never include a path or credential.
VITE_TMDB_SEARCH_ORIGIN=https://streamflicker.vercel.app

# Optional affiliate identifiers. Only use IDs from programs that have approved StreamFlicker.
VITE_AFFILIATE_AMAZON_TAG=
VITE_AFFILIATE_APPLE_TOKEN=
VITE_AFFILIATE_IMPACT_SUB_ID=
VITE_AFFILIATE_EBAY_CAMPAIGN_ID=
# Optional first-party endpoint for privacy-conscious outbound click reporting.
VITE_AFFILIATE_CLICK_ENDPOINT=

# Optional website-only destinations. Leave blank until the provider is ready.
VITE_NEWSLETTER_URL=
VITE_SUPPORT_URL=
VITE_SPONSOR_INQUIRY_URL=

# Optional disclosed sponsor placement. Name, headline, and URL are required.
VITE_SPONSOR_NAME=
VITE_SPONSOR_HEADLINE=
VITE_SPONSOR_COPY=
VITE_SPONSOR_URL=
VITE_SPONSOR_CTA=
VITE_SPONSOR_IMAGE_URL=

# Optional Google AdSense. Keep disabled until the site is approved and a CMP is configured.
VITE_ADSENSE_ENABLED=false
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_HOME_SLOT=
VITE_ADSENSE_RESULTS_SLOT=
